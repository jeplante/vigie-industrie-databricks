{
  "name": "vigie-operations-monitor",
  "max_concurrent_runs": 1,
  "email_notifications": {},
  "schedule": {
    "quartz_cron_expression": "0 45 6 * * ?",
    "timezone_id": "America/Toronto",
    "pause_status": "UNPAUSED"
  },
  "parameters": [{"name": "dry_run", "default": "false"}],
  "environments": [{
    "environment_key": "Default",
    "spec": {
      "environment_version": "5",
      "dependencies": ["/Workspace/Users/jerome.plante@hotmail.com/vigie_databricks_finance/vigie_databricks_foundation-0.9.6-py3-none-any.whl"]
    }
  }],
  "tasks": [{
    "task_key": "operations_monitor",
    "environment_key": "Default",
    "python_wheel_task": {
      "package_name": "vigie_databricks_foundation",
      "entry_point": "operations_monitor",
      "parameters": [
        "--gold-object", "workspace.vigie.gold_observations",
        "--finance-audit-object", "workspace.vigie.finance_run_audit",
        "--validated-object", "workspace.vigie.finance_history_validated",
        "--audit-object", "workspace.vigie.operations_monitor_audit",
        "--app-name", "vigie-gold-viewer",
        "--dry-run", "{{job.parameters.dry_run}}",
        "--run-id", "{{job.run_id}}"
      ]
    }
  }]
}
