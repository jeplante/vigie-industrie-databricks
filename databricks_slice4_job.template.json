{
  "name": "vigie-slice4-bronze-silver-gold",
  "max_concurrent_runs": 1,
  "parameters": [
    {"name": "catalog", "default": "workspace"},
    {"name": "schema", "default": "vigie"},
    {"name": "bronze_object", "default": "workspace.vigie.bronze_observations"},
    {"name": "silver_object", "default": "workspace.vigie.silver_observations"},
    {"name": "gold_object", "default": "workspace.vigie.gold_observations"},
    {"name": "finance_audit_object", "default": "workspace.vigie.finance_run_audit"},
    {"name": "config_directory", "default": "/Workspace/Users/jerome.plante@hotmail.com/vigie_databricks_finance/config"},
    {"name": "candidate_fixture_path", "default": "/Workspace/Users/jerome.plante@hotmail.com/vigie_databricks_finance/slice10_insurer_observations.json"}
  ],
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "5",
        "dependencies": ["/Workspace/Users/jerome.plante@hotmail.com/vigie_databricks_finance/vigie_databricks_foundation-0.5.0-py3-none-any.whl"]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "finance_publish",
      "environment_key": "Default",
      "python_wheel_task": {
        "package_name": "vigie_databricks_foundation",
        "entry_point": "finance_publish",
        "parameters": [
          "--config-directory", "{{job.parameters.config_directory}}",
          "--candidate-fixture-path", "{{job.parameters.candidate_fixture_path}}",
          "--bronze-object", "{{job.parameters.bronze_object}}",
          "--silver-object", "{{job.parameters.silver_object}}",
          "--gold-object", "{{job.parameters.gold_object}}",
          "--audit-object", "{{job.parameters.finance_audit_object}}",
          "--run-id", "{{job.run_id}}"
        ]
      }
    }
  ]
}
